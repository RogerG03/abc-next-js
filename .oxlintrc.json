{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "vitest", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["./globals.css", "@testing-library/jest-dom/vitest"]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "no-nested-ternary": "error"
  },
  "ignorePatterns": [".next", "coverage", "playwright-report", "test-results"],
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/modules/**", "@/server/**"],
                "message": "shared/ no conoce rutas, m\u00f3dulos ni infraestructura."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**"],
                "message": "Un m\u00f3dulo no importa rutas."
              },
              {
                "group": ["@/modules/*/**"],
                "message": "Usa imports relativos dentro del m\u00f3dulo y @/modules/<modulo> (index.ts) entre m\u00f3dulos."
              }
            ]
          }
        ]
      }
    }
  ]
}
